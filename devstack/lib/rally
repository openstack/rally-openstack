# lib/rally
# Functions to control the configuration and operation of the **Rally**

# Dependencies:
#
# - ``functions`` file
# - ``DEST``, ``DATA_DIR``, ``STACK_USER`` must be defined

# ``stack.sh`` calls the entry points in this order:
#
# - install_rally
# - configure_rally
# - init_rally

# Save trace setting
XTRACE=$(set +o | grep xtrace)
set +o xtrace


# Defaults
# --------

# Set up default directories
DIR=$(dirname ${BASH_SOURCE[0]})
RALLY_DIR=$(readlink -m $DIR/../..)
RALLY_CONF_DIR=${RALLY_CONF_DIR:-/etc/rally}
RALLY_CONF_FILE=rally.conf

# Rally should be treated as an "client" to the cloud. No matter of version
#   of target cloud, rally should be installable, so we install it in
#   a separate venv where we can manage requirements easily
RALLY_VENV=${RALLY_VENV:-$DATA_DIR/rally-venv}

# Debug mode
RALLY_DEBUG=${RALLY_DEBUG:-False}

# Create a rally env for the DevStack cloud. RALLY_ADD_DEPLOYMENT is the
# former name of the setting and is still honoured.
RALLY_ADD_ENV=${RALLY_ADD_ENV:-${RALLY_ADD_DEPLOYMENT:-"True"}}
RALLY_ADD_ENV=$(trueorfalse True $RALLY_ADD_ENV)

# Integration with OSprofiler
OSPROFILER_HMAC_KEYS=${OSPROFILER_HMAC_KEYS:-""}
OSPROFILER_CONNECTION_STRING=${OSPROFILER_CONNECTION_STRING:-""}

# Functions
# ---------

# Creates a rally env spec for the DevStack cloud
# Uses the following variables:
#
# - ``ADMIN_PASSWORD``, ``REGION_NAME``
#   ``KEYSTONE_SERVICE_URI``
#   ``OSPROFILER_HMAC_KEYS`` - optional, for integration with osprofiler
#   ``OSPROFILER_CONNECTION_STRING`` - optional, if this is set together with
#       OSPROFILER_HMAC_KEYS rally html report will use osprofiler api to
#       generate html report for each trace and embed it as iframe to our
#       native html report
#   ``RALLY_OSPROFILER_CHART`` - optional, a path to store osprofiler's reports
#

# _create_env_spec filename
function _create_env_spec() {
cat >$1 <<EOF
{
    "existing@openstack": {
        "auth_url": "$KEYSTONE_SERVICE_URI",
        "region_name": "$REGION_NAME",
        "admin": {
            "username": "admin",
            "password": "$ADMIN_PASSWORD",
            "project_name": "admin",
            "user_domain_name": "Default",
            "project_domain_name": "Default"
        },
EOF

# Trust the DevStack CA (tls-proxy)
if [[ -f "$SSL_BUNDLE_FILE" ]]; then
    cat >>$1 <<EOF
        "https_cacert": "$SSL_BUNDLE_FILE",
EOF
fi

# Now add osprofiler config if necessary
if [[ ! -z "$OSPROFILER_HMAC_KEYS" ]]; then
    cat >>$1 <<EOF
        "profiler_hmac_key": $OSPROFILER_HMAC_KEYS,
EOF
fi
if [[ ! -z "$OSPROFILER_CONNECTION_STRING" ]]; then
    cat >>$1 <<EOF
        "profiler_conn_str": "$OSPROFILER_CONNECTION_STRING",
EOF
fi

# And finish file
cat >>$1 <<EOF
    }
}
EOF
}

# install_rally() - Collect source and prepare
function install_rally() {
    if [[ ! -d $RALLY_VENV ]]; then
        python$PYTHON3_VERSION -m venv $RALLY_VENV
        $RALLY_VENV/bin/pip install -U pip
    fi
    local rally_constraints=$RALLY_DIR/upper-constraints.txt
    if use_library_from_git "rally"; then
        # Zuul puts every required project into LIBS_FROM_GIT, so jobs that
        # require openstack/rally install it from $DEST/rally. The source
        # version never matches the rally pin in upper-constraints.txt.
        rally_constraints=$DATA_DIR/rally-upper-constraints.txt
        grep -v '^rally===' $RALLY_DIR/upper-constraints.txt > $rally_constraints
    fi
    local rally_pip="$RALLY_VENV/bin/pip install -c $rally_constraints"
    if use_library_from_git "rally"; then
        $rally_pip -e $DEST/rally
    fi
    $rally_pip -e $RALLY_DIR

    # rally.conf gets the same database URL as the services, so the venv
    # needs the driver and the SQLAlchemy plugin that URL refers to.
    local db_url
    db_url=$(database_connection_url rally)
    if [[ $db_url == mysql+pymysql://* ]]; then
        $rally_pip PyMySQL
    fi
    if [[ $db_url == *plugin=dbcounter* ]]; then
        $rally_pip $TOP_DIR/tools/dbcounter
    fi

    # fix_system_ca_bundle_path only knows the devstack venv, point it at
    # ours so rally trusts the devstack CA.
    GLOBAL_VENV=True DEVSTACK_VENV=$RALLY_VENV fix_system_ca_bundle_path

    sudo ln -sf $RALLY_VENV/bin/rally /usr/local/bin/rally
}

# configure_rally() - Set config files, create data dirs, etc
function configure_rally() {

    if [[ ! -d $RALLY_CONF_DIR ]]; then
        sudo mkdir -p $RALLY_CONF_DIR
    fi
    sudo chown $STACK_USER $RALLY_CONF_DIR

    # Copy over rally configuration file and configure common parameters.
    cp $RALLY_DIR/etc/rally/rally.conf.sample $RALLY_CONF_DIR/$RALLY_CONF_FILE

    iniset $RALLY_CONF_DIR/$RALLY_CONF_FILE DEFAULT debug $RALLY_DEBUG

    iniset $RALLY_CONF_DIR/$RALLY_CONF_FILE database connection `database_connection_url rally`

    iniset $RALLY_CONF_DIR/$RALLY_CONF_FILE DEFAULT use_syslog $SYSLOG
}


# init_rally() - Initialize databases, etc.
function init_rally() {
    recreate_database rally utf8
    # Recreate rally database
    rally --config-file $RALLY_CONF_DIR/$RALLY_CONF_FILE db recreate
    # Add the DevStack cloud to Rally as an env
    if [ "$RALLY_ADD_ENV" = "True" ]; then
        local tmpfile=$(mktemp)
        _create_env_spec $tmpfile
        rally --config-file $RALLY_CONF_DIR/$RALLY_CONF_FILE env create --name devstack --spec $tmpfile
    fi
}

# Restore xtrace
$XTRACE

